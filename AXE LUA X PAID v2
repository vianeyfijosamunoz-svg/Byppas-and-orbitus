-- Función para iniciar el script principal
local function loadMainScript()
    KeyGui:Destroy()

    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local HumanoidRootPart = Character:WaitForChild('HumanoidRootPart')
    local Camera = workspace.CurrentCamera

    local orbMode = 1
    local slingActive = false
    local menuVisible = true
    local orbConn, slingConn, childAddedConn, childRemovedConn, uekillersV2Conn
    local angle = 0
    local projectiles = {}

    local ScreenGui = Instance.new('ScreenGui', PlayerGui)
    ScreenGui.Name = 'AxeRivalsGui'
    ScreenGui.ResetOnSpawn = false

    local RainbowLabel = Instance.new('TextLabel', ScreenGui)
    RainbowLabel.Size = UDim2.new(0, 300, 0, 40)
    RainbowLabel.Position = UDim2.new(0.5, -150, 0.1, 0)
    RainbowLabel.BackgroundTransparency = 1
    RainbowLabel.Text = ""
    RainbowLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    RainbowLabel.Font = Enum.Font.GothamBold
    RainbowLabel.TextSize = 18
    RainbowLabel.Visible = false

    local ToggleBtn = Instance.new('TextButton', ScreenGui)
    ToggleBtn.Size = UDim2.new(0, 120, 0, 40)
    ToggleBtn.Position = UDim2.new(0.05, 0, 0.5, 0)
    ToggleBtn.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    ToggleBtn.Text = 'AXE RIVALS'
    ToggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleBtn.Font = Enum.Font.GothamBold
    ToggleBtn.TextSize = 14
    ToggleBtn.Draggable = true
    Instance.new('UICorner', ToggleBtn).CornerRadius = UDim.new(0, 8)
    Instance.new('UIStroke', ToggleBtn).Color = Color3.fromRGB(200, 50, 50)

    local MainFrame = Instance.new('Frame', ScreenGui)
    MainFrame.Size = UDim2.new(0, 180, 0, 200)
    MainFrame.Position = UDim2.new(0.5, -90, 0.5, -100)
    MainFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 22)
    MainFrame.Active = true
    MainFrame.Draggable = true
    Instance.new('UICorner', MainFrame).CornerRadius = UDim.new(0, 10)
    Instance.new('UIStroke', MainFrame).Color = Color3.fromRGB(200, 50, 50)

    local Title = Instance.new('TextLabel', MainFrame)
    Title.Size = UDim2.new(1, 0, 0, 35)
    Title.BackgroundTransparency = 1
    Title.Text = 'AXE RIVALS V2'
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 16

    local StatusLabel = Instance.new('TextLabel', MainFrame)
    StatusLabel.Size = UDim2.new(1, 0, 0, 20)
    StatusLabel.Position = UDim2.new(0, 0, 0, 30)
    StatusLabel.BackgroundTransparency = 1
    StatusLabel.Text = 'STATUS: IDLE'
    StatusLabel.TextColor3 = Color3.fromRGB(100, 100, 100)
    StatusLabel.TextSize = 10
    StatusLabel.Font = Enum.Font.GothamMedium

    local OrbBtn = Instance.new('TextButton', MainFrame)
    OrbBtn.Size = UDim2.new(0, 160, 0, 32)
    OrbBtn.Position = UDim2.new(0, 10, 0, 55)
    OrbBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    OrbBtn.Text = 'ORBIT: OFF'
    OrbBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    OrbBtn.Font = Enum.Font.GothamBold
    OrbBtn.TextSize = 11
    Instance.new('UICorner', OrbBtn).CornerRadius = UDim.new(0, 6)

    local ModeBtn = Instance.new('TextButton', MainFrame)
    ModeBtn.Size = UDim2.new(0, 160, 0, 32)
    ModeBtn.Position = UDim2.new(0, 10, 0, 95)
    ModeBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    ModeBtn.Text = 'MODE: BAITING'
    ModeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    ModeBtn.Font = Enum.Font.GothamBold
    ModeBtn.TextSize = 11
    Instance.new('UICorner', ModeBtn).CornerRadius = UDim.new(0, 6)

    local SlingBtn = Instance.new('TextButton', MainFrame)
    SlingBtn.Size = UDim2.new(0, 160, 0, 32)
    SlingBtn.Position = UDim2.new(0, 10, 0, 135)
    SlingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    SlingBtn.Text = 'PROJECTILE REDIRECT'
    SlingBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SlingBtn.Font = Enum.Font.GothamBold
    SlingBtn.TextSize = 10
    Instance.new('UICorner', SlingBtn).CornerRadius = UDim.new(0, 6)

    local function updateStatus()
        local parts = {}
        if orbConn then 
            local modeNames = {"BAITING", "CLASSIC", "ONLY KNIFE", "UEKILLERS V2"}
            table.insert(parts, modeNames[orbMode]) 
        end
        if slingActive then table.insert(parts, "REDIRECT") end
        StatusLabel.Text = (#parts > 0) and ("STATUS: " .. table.concat(parts, " | ")) or "STATUS: IDLE"
    end

    local function isTargetValid(player)
        if player == LocalPlayer or not player.Character then return false end
        local isTeammate = (LocalPlayer.Team ~= nil and player.Team == LocalPlayer.Team)
        if isTeammate then return false end
        local humanoid = player.Character:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return false end
        local head = player.Character:FindFirstChild("Head")
        if head then
            for _, child in ipairs(head:GetChildren()) do
                if child:IsA("BillboardGui") and child.Enabled then
                    return false
                end
            end
        end
        return true
    end

    ToggleBtn.MouseButton1Click:Connect(function()
        menuVisible = not menuVisible
        MainFrame.Visible = menuVisible
    end)

    RunService.RenderStepped:Connect(function()
        if orbConn then
            local hue = tick() % 5 / 5
            RainbowLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
        end
    end)

    ModeBtn.Activated:Connect(function()
        orbMode = orbMode + 1
        if orbMode > 4 then orbMode = 1 end
        local modeNames = {"BAITING", "CLASSIC", "ONLY KNIFE", "UEKILLERS V2"}
        ModeBtn.Text = "MODE: " .. modeNames[orbMode]
        updateStatus()
    end)

    OrbBtn.Activated:Connect(function()
        if orbConn then
            orbConn:Disconnect()
            orbConn = nil
            if uekillersV2Conn then uekillersV2Conn:Disconnect() uekillersV2Conn = nil end
            OrbBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            OrbBtn.Text = 'ORBIT: OFF'
            RainbowLabel.Visible = false
            RainbowLabel.Text = ""
        else
            OrbBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
            OrbBtn.Text = 'ORBIT: ON'
            RainbowLabel.Visible = true
            
            orbConn = RunService.Heartbeat:Connect(function()
                if not HumanoidRootPart or not HumanoidRootPart.Parent then return end
                
                if orbMode == 4 then
                    if not uekillersV2Conn then
                        uekillersV2Conn = RunService.Heartbeat:Connect(function()
                            local char = LocalPlayer.Character
                            if not char then return end
                            local hrp = char:FindFirstChild("HumanoidRootPart")
                            if not hrp then return end
                            
                            local closestDist = math.huge
                            local targetHRP = nil
                            local targetName = "Ninguno"
                            
                            for _, player in pairs(Players:GetPlayers()) do
                                if isTargetValid(player) then
                                    local enemyHRP = player.Character:FindFirstChild("HumanoidRootPart")
                                    if enemyHRP then
                                        local dist = (enemyHRP.Position - hrp.Position).Magnitude
                                        if dist < closestDist then
                                            closestDist = dist
                                            targetHRP = enemyHRP
                                            targetName = player.Name
                                        end
                                    end
                                end
                            end
                            
                            if targetHRP then
                                hrp.CFrame = targetHRP.CFrame * CFrame.new(0, 0, -1) * CFrame.Angles(0, math.rad(180), 0)
                                hrp.AssemblyLinearVelocity = Vector3.zero
                                hrp.AssemblyAngularVelocity = Vector3.zero
                                RainbowLabel.Text = 'target: "' .. targetName .. '"'
                            else
                                RainbowLabel.Text = 'target: "Ninguno"'
                            end
                        end)
                    end
                else
                    if uekillersV2Conn then uekillersV2Conn:Disconnect() uekillersV2Conn = nil end
                    
                    local closest, dist = nil, math.huge
                    for _, p in pairs(Players:GetPlayers()) do
                        if isTargetValid(p) and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (HumanoidRootPart.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then 
                                dist = d 
                                closest = p 
                            end
                        end
                    end
                    
                    if closest and closest.Character then
                        local hrp = closest.Character.HumanoidRootPart
                        local currentOrbitDist = (orbMode == 2) and 3 or 0
                        local currentOrbitSpeed = (orbMode == 2) and 10 or 0
                        
                        if orbMode == 1 then
                            angle = angle + (currentOrbitSpeed * 0.018)
                            HumanoidRootPart.CFrame = CFrame.new(hrp.Position + Vector3.new(0, -4, 0), hrp.Position)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, hrp.Position)
                        elseif orbMode == 2 then
                            angle = angle + (currentOrbitSpeed * 0.018)
                            HumanoidRootPart.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle) * currentOrbitDist, 4, math.sin(angle) * currentOrbitDist), hrp.Position)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, hrp.Position)
                        elseif orbMode == 3 then
                            HumanoidRootPart.CFrame = hrp.CFrame
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, hrp.Position)
                        end
                        
                        RainbowLabel.Text = 'target: "' .. closest.Name .. '"'
                    else
                        RainbowLabel.Text = 'target: "Ninguno"'
                    end
                end
            end)
        end
        updateStatus()
    end)

    SlingBtn.Activated:Connect(function()
        slingActive = not slingActive
        if slingActive then
            SlingBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 150)
            
            childAddedConn = workspace.ChildAdded:Connect(function(o)
                if not o:IsA("BasePart") then return end
                if o.Name == "CoreProjectile" or o.Name == "Bullet" or o.Name == "Projectile" then
                    projectiles[o] = true
                elseif o.Name == "Part" then
                    task.defer(function()
                        if o and o.Parent and o.AssemblyLinearVelocity.Magnitude > 20 then
                            projectiles[o] = true
                        end
                    end)
                end
            end)
            
            childRemovedConn = workspace.ChildRemoved:Connect(function(o)
                projectiles[o] = nil
            end)
            
            slingConn = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local targetHRP = nil
                    local shortestDist = math.huge
                    
                    for _, p in ipairs(Players:GetPlayers()) do
                        if isTargetValid(p) then
                            local h = p.Character:FindFirstChild("HumanoidRootPart")
                            if h then
                                local dist = (HumanoidRootPart.Position - h.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetHRP = h
                                end
                            end
                        end
                    end
                    
                    for o in pairs(projectiles) do
                        if o and o.Parent then
                            if targetHRP then
                                local speed = 8.5
                                o.CFrame = o.CFrame:Lerp(CFrame.new(o.Position, targetHRP.Position), 0.75) + (targetHRP.Position - o.Position).Unit * speed
                                o.AssemblyLinearVelocity = Vector3.zero
                            else
                                o.AssemblyLinearVelocity = Vector3.zero
                            end
                        else
                            projectiles[o] = nil
                        end
                    end
                end)
            end)
        else
            SlingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
            if slingConn then slingConn:Disconnect() slingConn = nil end
            if childAddedConn then childAddedConn:Disconnect() childAddedConn = nil end
            if childRemovedConn then childRemovedConn:Disconnect() childRemovedConn = nil end
            projectiles = {}
        end
        updateStatus()
    end)

    LocalPlayer.CharacterAdded:Connect(function(c)
        Character = c
        HumanoidRootPart = c:WaitForChild('HumanoidRootPart')
    end)
end

-- Lógica de validación con animación de Key Válida e Inválida
local isVerifying = false

SubmitBtn.MouseButton1Click:Connect(function()
    if isVerifying then return end
    isVerifying = true
    
    local enteredKey = KeyBox.Text
    
    if VALID_KEYS[enteredKey] then
        -- Animación de Key Válida
        SubmitBtn.Text = "KEY VÁLIDA ✓"
        TweenService:Create(SubmitBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(50, 200, 50)}):Play()
        
        task.wait(0.8)
        
        -- Animación de cierre suave de la ventana de key
        local info = TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
        TweenService:Create(KeyFrame, info, {Size = UDim2.new(0, 0, 0, 0), Position = KeyFrame.Position + UDim2.new(0, 120, 0, 92)}):Play()
        task.wait(0.4)
        
        loadMainScript()
    else
        -- Animación de Key Inválida
        SubmitBtn.Text = "KEY INVÁLIDA ✕"
        TweenService:Create(SubmitBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}):Play()
        
        -- Pequeño efecto de sacudida (Shake) en el cuadro
        local originalPos = KeyFrame.Position
        for i = 1, 3 do
            KeyFrame.Position = originalPos + UDim2.new(0, 5, 0, 0)
            task.wait(0.05)
            KeyFrame.Position = originalPos + UDim2.new(0, -5, 0, 0)
            task.wait(0.05)
        end
        KeyFrame.Position = originalPos
        
        task.wait(0.8)
        
        -- Regresar al estado normal
        SubmitBtn.Text = "VERIFICAR KEY"
        TweenService:Create(SubmitBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 50, 50)}):Play()
        isVerifying = false
    end
end)
