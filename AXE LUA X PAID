    if orbActive then
        local hue = tick() % 5 / 5
        rainbowLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
    end
end)

baitBtn.Activated:Connect(function()
    baitActive = not baitActive
    baitBtn.BackgroundColor3 = baitActive and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(30, 30, 35)
    baitBtn.Text = baitActive and "BAITING: ON" or "BAITING: OFF"
    updateStatus()
end)

orbBtn.Activated:Connect(function()
    orbActive = not orbActive
    orbBtn.BackgroundColor3 = orbActive and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(30, 30, 35)
    rainbowLabel.Visible = orbActive
    
    if orbActive then
        orbConn = v10.Heartbeat:Connect(function()
            local closest, dist = nil, math.huge
            for _, p in pairs(v8:GetPlayers()) do
                local isTeammate = (v11.Team ~= nil and p.Team == v11.Team)
                
                if p ~= v11 and not isTeammate and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (v13.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then 
                        dist = d 
                        closest = p 
                    end
                end
            end
            
            if closest and closest.Character then
                local hrp = closest.Character.HumanoidRootPart
                local mappedSpeed = orbitSpeed * 0.018
                angle = angle + mappedSpeed
                
                local targetHeight = baitActive and -4 or 4
                
                v13.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle) * orbitDistance, targetHeight, math.sin(angle) * orbitDistance), hrp.Position)
                
                camera.CFrame = CFrame.new(camera.CFrame.Position, hrp.Position)
                rainbowLabel.Text = 'orbitus: "' .. closest.Name .. '"'
            else
                rainbowLabel.Text = 'orbitus: "Ninguno"'
            end
        end)
    else
        if orbConn then orbConn:Disconnect() end
        rainbowLabel.Text = ""
    end
    updateStatus()
end)

slingBtn.Activated:Connect(function()
    slingActive = not slingActive
    if slingActive then
        slingBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 150)
        
        childAddedConn = workspace.ChildAdded:Connect(function(o)
            if not o:IsA("BasePart") then return end
            if o.Name == "CoreProjectile" then
                projectiles[o] = true
            elseif o.Name == "Part" then
                task.defer(function()
                    if o and o.Parent and o.AssemblyLinearVelocity.Magnitude > 10 then
                        projectiles[o] = true
                    end
                end)
            end
        end)
        
        childRemovedConn = workspace.ChildRemoved:Connect(function(o)
            projectiles[o] = nil
        end)
        
        slingConn = v10.Heartbeat:Connect(function()
            pcall(function()
                local targetHRP = nil
                local shortestDist = math.huge
                
                for _, p in ipairs(v8:GetPlayers()) do
                    if p ~= v11 then
                        local isTeammate = (v11.Team ~= nil and p.Team == v11.Team)
                        local hasProfileAbove = false
                        
                        if p.Character and p.Character:FindFirstChild("Head") then
                            for _, child in ipairs(p.Character.Head:GetChildren()) do
                                if child:IsA("BillboardGui") and child.Enabled then
                                    hasProfileAbove = true
                                    break
                                end
                            end
                        end
                        
                        if not isTeammate and not hasProfileAbove and p.Character then
                            local h = p.Character:FindFirstChild("HumanoidRootPart")
                            if h then
                                local dist = (v13.Position - h.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetHRP = h
                                end
                            end
                        end
                    end
                end
                
                for o in pairs(projectiles) do
                    if o and o.Parent then
                        if targetHRP then
                            local speed = 6.5
                            o.CFrame = o.CFrame:Lerp(CFrame.new(o.Position, targetHRP.Position), 0.7) + (targetHRP.Position - o.Position).Unit * speed
                            o.AssemblyLinearVelocity = Vector3.zero
                        else
                            o.AssemblyLinearVelocity = Vector3.zero
                        end
                    else
                        projectiles[o] = nil
                    end
                end
            end)
        end)
    else
        slingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        if slingConn then slingConn:Disconnect() slingConn = nil end
        if childAddedConn then childAddedConn:Disconnect() childAddedConn = nil end
        if childRemovedConn then childRemovedConn:Disconnect() childRemovedConn = nil end
        projectiles = {}
    end
    updateStatus()
end)

v11.CharacterAdded:Connect(function(c) 
    v12 = c
