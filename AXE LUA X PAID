local function updateStatus()
    local parts = {}
    if orbActive then table.insert(parts, "ORBIT") end
    if baitActive then table.insert(parts, "BAIT") end
    if slingActive then table.insert(parts, "BYPASS") end
    v70.Text = (#parts > 0) and ("STATUS: " .. table.concat(parts, " | ")) or "STATUS: IDLE"
end

