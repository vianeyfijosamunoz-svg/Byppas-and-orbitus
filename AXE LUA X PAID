local function updateStatus()
    local parts = {}
    if orbConn then 
        local modeNames = {"BAITING", "CLASSIC", "ONLY KNIFE", "UEKILLERS"}
        table.insert(parts, modeNames[orbMode]) 
    end
    if slingActive then table.insert(parts, "BYPASS") end
    v70.Text = (#parts > 0) and ("STATUS: " .. table.concat(parts, " | ")) or "STATUS: IDLE"
end

