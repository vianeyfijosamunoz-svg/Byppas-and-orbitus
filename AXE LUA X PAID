orbBtn.Activated:Connect(function()
    if orbConn then
        orbConn:Disconnect()
        orbConn = nil
        orbBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        orbBtn.Text = 'ORBIT: OFF'
        rainbowLabel.Visible = false
        rainbowLabel.Text = ""
    else
        orbBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        orbBtn.Text = 'ORBIT: ON'
        rainbowLabel.Visible = true
        
        orbConn = v10.Heartbeat:Connect(function()
            if not v13 or not v13.Parent then return end
            
            if orbMode == 4 then
                local closestDist = math.huge
                local closestPlayer = nil
                for _, player in pairs(v8:GetPlayers()) do
                    local isTeammate = (v11.Team ~= nil and player.Team == v11.Team)
                    if player ~= v11 and not isTeammate and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
                        local head = player.Character:FindFirstChild("Head")
                        local hrp = player.Character:FindFirstChild("HumanoidRootPart")
                        if head and hrp then
                            local dist = (hrp.Position - v13.Position).Magnitude
                            if dist < closestDist then
                                closestDist = dist
                                closestPlayer = player
                            end
                        end
                    end
                end
                
                if closestPlayer and closestPlayer.Character then
                    local head = closestPlayer.Character:FindFirstChild("Head")
                    if head then
                        local camCFrame = camera.CFrame
                        local targetPos = head.Position
                        local direction = (targetPos - camCFrame.Position).Unit
                        camera.CFrame = CFrame.new(camCFrame.Position, camCFrame.Position + direction)
                    end
                    rainbowLabel.Text = 'orbitus: "' .. closestPlayer.Name .. '"'
                else
                    rainbowLabel.Text = 'orbitus: "Ninguno"'
                end
                
                v13.AssemblyLinearVelocity = Vector3.new(0, 200, 0)
            else
                local closest, dist = nil, math.huge
                for _, p in pairs(v8:GetPlayers()) do
                    local isTeammate = (v11.Team ~= nil and p.Team == v11.Team)
                    
                    if p ~= v11 and not isTeammate and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (v13.Position - p.Character.HumanoidRootPart.Position).Magnitude
                        if d < dist then 
                            dist = d 
                            closest = p 
                        end
                    end
                end
                
                if closest and closest.Character then
                    local hrp = closest.Character.HumanoidRootPart
                    
                    local currentOrbitDist = (orbMode == 2) and 3 or 0
                    local currentOrbitSpeed = (orbMode == 2) and 10 or 0
                    
                    if orbMode == 1 then
                        angle = angle + (currentOrbitSpeed * 0.018)
                        v13.CFrame = CFrame.new(hrp.Position + Vector3.new(0, -4, 0), hrp.Position)
                        camera.CFrame = CFrame.new(camera.CFrame.Position, hrp.Position)
                    elseif orbMode == 2 then
                        angle = angle + (currentOrbitSpeed * 0.018)
                        v13.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle) * currentOrbitDist, 4, math.sin(angle) * currentOrbitDist), hrp.Position)
                        camera.CFrame = CFrame.new(camera.CFrame.Position, hrp.Position)
                    elseif orbMode == 3 then
                        v13.CFrame = hrp.CFrame
                        camera.CFrame = CFrame.new(camera.CFrame.Position, hrp.Position)
                    end
                    
                    rainbowLabel.Text = 'orbitus: "' .. closest.Name .. '"'
                else
                    rainbowLabel.Text = 'orbitus: "Ninguno"'
                end
            end
        end)
    end
    updateStatus()
end)

slingBtn.Activated:Connect(function()
    slingActive = not slingActive
    if slingActive then
        slingBtn.BackgroundColor3 = Color3.fromRGB(60, 40, 150)
        
        childAddedConn = workspace.ChildAdded:Connect(function(o)
            if not o:IsA("BasePart") then return end
            if o.Name == "CoreProjectile" then
                projectiles[o] = true
            elseif o.Name == "Part" then
                task.defer(function()
                    if o and o.Parent and o.AssemblyLinearVelocity.Magnitude > 10 then
                        projectiles[o] = true
                    end
                end)
            end
        end)
        
        childRemovedConn = workspace.ChildRemoved:Connect(function(o)
            projectiles[o] = nil
        end)
        
        slingConn = v10.Heartbeat:Connect(function()
            pcall(function()
                local targetHRP = nil
                local shortestDist = math.huge
                
                for _, p in ipairs(v8:GetPlayers()) do
                    if p ~= v11 then
                        local isTeammate = (v11.Team ~= nil and p.Team == v11.Team)
                        local hasProfileAbove = false
                        
                        if p.Character and p.Character:FindFirstChild("Head") then
                            for _, child in ipairs(p.Character.Head:GetChildren()) do
                                if child:IsA("BillboardGui") and child.Enabled then
                                    hasProfileAbove = true
                                    break
                                end
                            end
                        end
                        
                        if not isTeammate and not hasProfileAbove and p.Character then
                            local h = p.Character:FindFirstChild("HumanoidRootPart")
                            if h then
                                local dist = (v13.Position - h.Position).Magnitude
                                if dist < shortestDist then
                                    shortestDist = dist
                                    targetHRP = h
                                end
                            end
                        end
                    end
                end
                
                for o in pairs(projectiles) do
                    if o and o.Parent then
                        if targetHRP then
                            local speed = 6.5
                            o.CFrame = o.CFrame:Lerp(CFrame.new(o.Position, targetHRP.Position), 0.7) + (targetHRP.Position - o.Position).Unit * speed
                            o.AssemblyLinearVelocity = Vector3.zero
                        else
                            o.AssemblyLinearVelocity = Vector3.zero
                        end
                    else
                        projectiles[o] = nil
                    end
                end
            end)
        end)
    else
        slingBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        if slingConn then slingConn:Disconnect() slingConn = nil end
        if childAddedConn then childAddedConn:Disconnect() childAddedConn = nil end
        if childRemovedConn then childRemovedConn:Disconnect() childRemovedConn = nil end
        projectiles = {}
    end
    updateStatus()
end)

