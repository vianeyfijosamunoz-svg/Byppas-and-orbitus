speedBox.FocusLost:Connect(function()
    local num = tonumber(speedBox.Text:match("%d+"))
    if num then
        if num < 100 then num = 100 end
        if num > 5000 then num = 5000 end
        orbitSpeed = num
        speedBox.Text = "Velocidad: " .. orbitSpeed
    else
        speedBox.Text = "Velocidad: " .. orbitSpeed
    end
end)

studsBox.FocusLost:Connect(function()
    local num = tonumber(studsBox.Text:match("%d+"))
    if num then
        if num < 0 then num = 0 end
        orbitDistance = num
        studsBox.Text = "Studs: " .. orbitDistance
    else
        studsBox.Text = "Studs: " .. orbitDistance
    end
end)

local function updateStatus()
    local parts = {}
    if orbActive then table.insert(parts, "ORBIT") end
    if slingActive then table.insert(parts, "BYPASS") end
    v70.Text = (#parts > 0) and ("STATUS: " .. table.concat(parts, " | ")) or "STATUS: IDLE"
end

