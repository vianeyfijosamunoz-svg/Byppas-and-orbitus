    v27.Visible = menuVisible
end)

-- Bucle de Efecto Rainbow para el texto superior
v10.RenderStepped:Connect(function()
    if orbActive then
        local hue = tick() % 5 / 5
        rainbowLabel.TextColor3 = Color3.fromHSV(hue, 1, 1)
    end
end)

orbBtn.Activated:Connect(function()
    orbActive = not orbActive
    orbBtn.BackgroundColor3 = orbActive and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(30, 30, 35)
    rainbowLabel.Visible = orbActive
    
    if orbActive then
        orbConn = v10.Heartbeat:Connect(function()
            local closest, dist = nil, math.huge
            for _, p in pairs(v8:GetPlayers()) do
                if p ~= v11 and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    local d = (v13.Position - p.Character.HumanoidRootPart.Position).Magnitude
                    if d < dist then dist = d closest = p end
                end
            end
            
            if closest and closest.Character then
                local hrp = closest.Character.HumanoidRootPart
                local mappedSpeed = (orbitSpeed / 500) * 0.018
                angle = angle + mappedSpeed
                
                -- Aplicar posición de órbita
                v13.CFrame = CFrame.new(hrp.Position + Vector3.new(math.cos(angle) * orbitDistance, 4, math.sin(angle) * orbitDistance), hrp.Position)
                
                -- Aimbot: fijar la cámara al objetivo del orbitus
                camera.CFrame = CFrame.new(camera.CFrame.Position, hrp.Position)
                
                -- Actualizar texto rainbow con el nombre del objetivo
                rainbowLabel.Text = 'orbitus: "' .. closest.Name .. '"'
            else
                rainbowLabel.Text = 'orbitus: "Ninguno"'
            end
        end)
    else
        if orbConn then orbConn:Disconnect() end
        rainbowLabel.Text = ""
    end
    updateStatus()
end)

slingBtn.Activated:Connect(function()
    slingActive = not slingActive
    slingBtn.BackgroundColor3 = slingActive and Color3.fromRGB(200, 50, 50) or Color3.fromRGB(30, 30, 35)
    if slingActive then
        childAddedConn = workspace.ChildAdded:Connect(function(o)
            if o.Name == "CoreProjectile" or (o:IsA("BasePart") and o.AssemblyLinearVelocity.Magnitude > 50) then projectiles[o] = true end
        end)
        slingConn = v10.Heartbeat:Connect(function()
            for _, p in pairs(v8:GetPlayers()) do
                if p ~= v11 and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                    p.Character.HumanoidRootPart.AssemblyLinearVelocity = Vector3.new(math.random(-5, 5), -15, math.random(-5, 5)) 
                end 
            end
            for o in pairs(projectiles) do
                if o and o.Parent then o.AssemblyLinearVelocity = Vector3.new(0, -5, 0) else projectiles[o] = nil end 
            end
        end)
    else
        if slingConn then slingConn:Disconnect() end
        if childAddedConn then childAddedConn:Disconnect() end
        projectiles = {}
    end
    updateStatus()
end)

v11.CharacterAdded:Connect(function(c) 
    v12 = c
    v13 = c:WaitForChild('HumanoidRootPart') 
end)
