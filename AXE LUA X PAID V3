    OrbBtn.Activated:Connect(function()
        if orbitEnabled then
            stopOrbit()
        else
            stopVoidSpam()
            stopNoVoidSpam()
            orbitEnabled = true
            OrbBtn.BackgroundColor3 = Color3.fromRGB(110, 55, 235)
            OrbBtn.Text = 'ORBIT: ON'
            
            orbConn = RunService.Heartbeat:Connect(function()
                pcall(function()
                    local _, hrp = getCharacterParts()
                    if not hrp then return end
                    
                    local closest, dist = nil, math.huge
                    for _, p in pairs(LocalPlayers:GetPlayers()) do
                        if isTargetValid(p) and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < dist then 
                                dist = d 
                                closest = p 
                            end
                        end
                    end
                    
                    if closest and closest.Character then
                        local enemyHrp = closest.Character.HumanoidRootPart
                        
                        if orbMode == 1 then
                            hrp.CFrame = CFrame.new(enemyHrp.Position + Vector3.new(0, -4, 0), enemyHrp.Position)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, enemyHrp.Position)
                        elseif orbMode == 2 then
                            angle = angle + 0.27
                            hrp.CFrame = CFrame.new(enemyHrp.Position + Vector3.new(math.cos(angle) * 3, 4, math.sin(angle) * 3), enemyHrp.Position)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, enemyHrp.Position)
                        elseif orbMode == 3 then
                            local enemyLook = enemyHrp.CFrame.LookVector
                            enemyLook = Vector3.new(enemyLook.X, 0, enemyLook.Z).Unit
                            hrp.CFrame = CFrame.new(enemyHrp.Position + (enemyLook * 3) + Vector3.new(0, 0.5, 0), enemyHrp.Position)
                            Camera.CFrame = CFrame.new(Camera.CFrame.Position, enemyHrp.Position)
                        end
                    end
                end)
            end)
        end
        updateStatus()
    end)

