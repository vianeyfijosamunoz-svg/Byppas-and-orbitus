            noVoidSpamConn = RunService.RenderStepped:Connect(function(dt)
                pcall(function()
                    local _, hrp = getCharacterParts()
                    if not hrp then return end
                    
                    local enemyNearby = false
                    for _, p in pairs(LocalPlayers:GetPlayers()) do
                        if isTargetValid(p) and p.Character:FindFirstChild("HumanoidRootPart") then
                            local d = (hrp.Position - p.Character.HumanoidRootPart.Position).Magnitude
                            if d < 40 then
                                enemyNearby = true
                                break
                            end
                        end
                    end

                    local movedDist = (hrp.Position - lastPos).Magnitude
                    if movedDist < 1.5 then
                        stuckTime = stuckTime + dt
                    else
                        stuckTime = 0
                        lastPos = hrp.Position
                    end

                    if enemyNearby or stuckTime > 0 then
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    else
                        voidAngle = voidAngle + (dt * 250000)
                        local x = math.cos(voidAngle) * 1000
                        local z = math.sin(voidAngle) * 1000
                        hrp.CFrame = CFrame.new(Vector3.new(x, 500, z))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                end)
            end)
        end
        updateStatus()
    end)

