        local bypassActiveList = {slingshot = false, daggers = false, bow = false, chainsaw = false}
        local function updateExclusiveBypass(key, state)
            if state then
                for k in pairs(bypassActiveList) do
                    if k ~= key then
                        bypassActiveList[k] = false
                        if k == "slingshot" and Toggles.BypassSling then Toggles.BypassSling:SetValue(false) end
                        if k == "daggers" and Toggles.BypassDaggers then Toggles.BypassDaggers:SetValue(false) end
                        if k == "bow" and Toggles.BypassBow then Toggles.BypassBow:SetValue(false) end
                        if k == "chainsaw" and Toggles.BypassChainsaw then Toggles.BypassChainsaw:SetValue(false) end
                    end
                end
                bypassActiveList[key] = true
            else
                bypassActiveList[key] = false
            end
        end

