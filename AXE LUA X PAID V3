                                            if getgenv().EspConfig.HealthText then infoStr = infoStr .. "[" .. math.floor(hum.Health) .. "HP] " end
                                            if getgenv().EspConfig.Distance then infoStr = infoStr .. "(" .. math.floor((camera.CFrame.Position - hrp.Position).Magnitude) .. "m)" end
                                            d.InfoText.Visible = true; d.InfoText.Text = infoStr; d.InfoText.Position = Vector2.new(vector.X, topPos.Y - 18); d.InfoText.Color = col
                                        else d.InfoText.Visible = false end

                                        if getgenv().EspConfig.Tracers then
                                            d.Tracer.Visible = true; d.Tracer.From = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y); d.Tracer.To = Vector2.new(vector.X, botPos.Y); d.Tracer.Color = col
                                        else d.Tracer.Visible = false end

                                        if getgenv().EspConfig.Skeletons and char:FindFirstChild("LeftUpperArm") and char:FindFirstChild("RightUpperArm") then
                                            local lArm = camera:WorldToViewportPoint(char.LeftUpperArm.Position)
                                            local rArm = camera:WorldToViewportPoint(char.RightUpperArm.Position)
                                            local lLeg = camera:WorldToViewportPoint(char:FindFirstChild("LeftUpperLeg") and char.LeftUpperLeg.Position or hrp.Position)
                                            local rLeg = camera:WorldToViewportPoint(char:FindFirstChild("RightUpperLeg") and char.RightUpperLeg.Position or hrp.Position)
                                            
                                            d.SkulHead.Visible = true; d.SkulHead.From = Vector2.new(vector.X, topPos.Y); d.SkulHead.To = Vector2.new(vector.X, vector.Y); d.SkulHead.Color = col
                                            d.SkulArmL.Visible = true; d.SkulArmL.From = Vector2.new(vector.X, vector.Y); d.SkulArmL.To = Vector2.new(lArm.X, lArm.Y); d.SkulArmL.Color = col
                                            d.SkulArmR.Visible = true; d.SkulArmR.From = Vector2.new(vector.X, vector.Y); d.SkulArmR.To = Vector2.new(rArm.X, rArm.Y); d.SkulArmR.Color = col
                                            d.SkulLegL.Visible = true; d.SkulLegL.From = Vector2.new(vector.X, hrp.Position.Y); d.SkulLegL.To = Vector2.new(lLeg.X, lLeg.Y); d.SkulLegL.Color = col
                                            d.SkulLegR.Visible = true; d.SkulLegR.From = Vector2.new(vector.X, hrp.Position.Y); d.SkulLegR.To = Vector2.new(rLeg.X, rLeg.Y); d.SkulLegR.Color = col
                                        else
                                            d.SkulHead.Visible = false; d.SkulArmL.Visible = false; d.SkulArmR.Visible = false; d.SkulLegL.Visible = false; d.SkulLegR.Visible = false
                                        end

                                        if getgenv().EspConfig.HeadDots then
                                            d.HeadDot.Visible = true; d.HeadDot.Position = Vector2.new(topPos.X, topPos.Y); d.HeadDot.Color = col
                                        else d.HeadDot.Visible = false end

                                        d.OffscreenArrow.Visible = false
                                    else
                                        d.Box.Visible = false; d.HealthBar.Visible = false; d.HealthBarBg.Visible = false; d.InfoText.Visible = false; d.Tracer.Visible = false; d.HeadDot.Visible = false; d.SkulHead.Visible = false; d.SkulArmL.Visible = false; d.SkulArmR.Visible = false; d.SkulLegL.Visible = false; d.SkulLegR.Visible = false

                                        if getgenv().EspConfig.OffscreenArrows and hum.Health > 0 then
                                            local screenCenter = Vector2.new(camera.ViewportSize.X / 2, camera.ViewportSize.Y / 2)
