                local currentCfg = espColors[espColorIndex]
                for _, p in pairs(LocalPlayers:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character then
                        local highlight = p.Character:FindFirstChild("AxeESP")
                        if not highlight then
                            highlight = Instance.new("Highlight")
                            highlight.Name = "AxeESP"
                            highlight.Adornee = p.Character
                            highlight.Parent = p.Character
                        end
                        
                        if currentCfg.color == "RAINBOW" then
                            local rainbowColor = Color3.fromHSV(tick() % 3 / 3, 1, 1)
                            highlight.FillColor = rainbowColor
                            highlight.OutlineColor = rainbowColor
                        else
                            highlight.FillColor = currentCfg.color
                            highlight.OutlineColor = currentCfg.outline
                        end
                        
                        highlight.FillTransparency = 0.05
                        highlight.OutlineTransparency = 0
                    end
                end
            end)
