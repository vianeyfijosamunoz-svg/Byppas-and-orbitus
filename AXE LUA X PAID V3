                    clearESP()
                    if espConn then espConn:Disconnect(); espConn = nil end
                else
                    if espConn then espConn:Disconnect() end
                    espConn = RunService.RenderStepped:Connect(function()
                        local camera = workspace.CurrentCamera
                        local colorMode = Options.EspColor.Value

                        for plr, data in pairs(espDrawings) do
                            if not plr or not plr.Character or not plr.Character:FindFirstChild("HumanoidRootPart") then
                                for _, d in pairs(data) do pcall(function() d:Remove() end) end
                                espDrawings[plr] = nil
                            end
                        end

                        for _, p in pairs(Players:GetPlayers()) do
                            if p ~= LocalPlayer and p.Character then
                                local char = p.Character
                                local hrp = char:FindFirstChild("HumanoidRootPart")
                                local hum = char:FindFirstChild("Humanoid")
                                local head = char:FindFirstChild("Head")

                                if hrp and hum and head and (not getgenv().EspConfig.TeamCheck or isEnemy(p)) then
                                    local vector, onScreen = camera:WorldToViewportPoint(hrp.Position)

                                    if not espDrawings[p] then
                                        espDrawings[p] = {
                                            Box = Drawing.new("Square"),
                                            HealthBarBg = Drawing.new("Square"),
                                            HealthBar = Drawing.new("Square"),
                                            InfoText = Drawing.new("Text"),
                                            Tracer = Drawing.new("Line"),
                                            HeadDot = Drawing.new("Circle"),
                                            OffscreenArrow = Drawing.new("Triangle"),
                                            SkulHead = Drawing.new("Line"),
                                            SkulArmL = Drawing.new("Line"),
                                            SkulArmR = Drawing.new("Line"),
                                            SkulLegL = Drawing.new("Line"),
                                            SkulLegR = Drawing.new("Line")
                                        }
                                        espDrawings[p].Box.Visible = false; espDrawings[p].Box.Filled = false; espDrawings[p].Box.Thickness = 1
                                        espDrawings[p].HealthBarBg.Visible = false; espDrawings[p].HealthBarBg.Filled = true; espDrawings[p].HealthBarBg.Color = Color3.fromRGB(0, 0, 0)
                                        espDrawings[p].HealthBar.Visible = false; espDrawings[p].HealthBar.Filled = true
                                        espDrawings[p].InfoText.Visible = false; espDrawings[p].InfoText.Size = 13; espDrawings[p].InfoText.Center = true; espDrawings[p].InfoText.Outline = true; espDrawings[p].InfoText.Font = 2
                                        espDrawings[p].Tracer.Visible = false; espDrawings[p].Tracer.Thickness = 1
                                        espDrawings[p].HeadDot.Visible = false; espDrawings[p].HeadDot.Filled = true; espDrawings[p].HeadDot.Radius = 3
                                        espDrawings[p].OffscreenArrow.Visible = false; espDrawings[p].OffscreenArrow.Filled = true
                                        espDrawings[p].SkulHead.Visible = false; espDrawings[p].SkulArmL.Visible = false; espDrawings[p].SkulArmR.Visible = false; espDrawings[p].SkulLegL.Visible = false; espDrawings[p].SkulLegR.Visible = false
                                    end

                                    local d = espDrawings[p]
                                    local col = (colorMode == "RAINBOW") and Color3.fromHSV(tick() % 3 / 3, 1, 1) or (colorMap[colorMode] or Color3.fromRGB(0, 242, 255))

                                    if onScreen and hum.Health > 0 then
                                        local topPos = camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
                                        local botPos = camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
                                        local height = math.abs(topPos.Y - botPos.Y)
                                        local width = height / 2

                                        if getgenv().EspConfig.Boxes then
                                            d.Box.Visible = true; d.Box.Size = Vector2.new(width, height); d.Box.Position = Vector2.new(vector.X - width / 2, topPos.Y); d.Box.Color = col
                                        else d.Box.Visible = false end

                                        if getgenv().EspConfig.HealthBar then
                                            local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                                            d.HealthBarBg.Visible = true; d.HealthBarBg.Size = Vector2.new(4, height + 2); d.HealthBarBg.Position = Vector2.new(vector.X - width / 2 - 7, topPos.Y - 1)
                                            d.HealthBar.Visible = true; d.HealthBar.Size = Vector2.new(2, height * healthPercent); d.HealthBar.Position = Vector2.new(vector.X - width / 2 - 6, topPos.Y + (height - (height * healthPercent)))
                                            d.HealthBar.Color = Color3.fromRGB(255 - (healthPercent * 255), healthPercent * 255, 0)
                                        else d.HealthBar.Visible = false; d.HealthBarBg.Visible = false end

                                        if getgenv().EspConfig.Names or getgenv().EspConfig.Distance or getgenv().EspConfig.HealthText then
                                            local infoStr = ""
